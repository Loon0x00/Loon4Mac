    <item>
      <title>Version 0.1 alpha (Build 42)</title><link>https://nsloon.app</link>
      <sparkle:version>42</sparkle:version><sparkle:shortVersionString>0.1(42)</sparkle:shortVersionString>
      <sparkle:releaseNotesLink>https://nsloon.app/Loon4Mac/changelog.html#build-42</sparkle:releaseNotesLink>
      <sparkle:fullReleaseNotesLink>https://nsloon.app/Loon4Mac/changelog.html</sparkle:fullReleaseNotesLink>
